# View-only GUI for engineers at the pad.
#
# Ships the `web` Vite target — the same codebase as the desktop app, built with
# command authority disabled (see src/lib/platform.js). Serves static files
# only: the browser talks to the API and mediamtx directly, so the server stack
# needs no changes to host this.

# Static assets are architecture-independent, so pin the build stage to the
# builder's own platform. Without this, an arm64 image would run the whole npm
# build under QEMU emulation for no benefit.
FROM --platform=$BUILDPLATFORM node:22-alpine AS build

WORKDIR /app

# Dependency layer, invalidated only by a lockfile change.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build:web

FROM nginx:alpine

COPY --from=build /app/dist-web /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# nginx runs everything in /docker-entrypoint.d/ before starting.
COPY docker/40-write-config.sh /docker-entrypoint.d/40-write-config.sh
RUN chmod +x /docker-entrypoint.d/40-write-config.sh

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
    CMD wget -qO- http://127.0.0.1:8080/health || exit 1
